#include <iostream>
using namespace std;

class Menu {
private:
    string opciones[10];
    int cantidad;

    void mostrarHorizontal() {
        for (int i = 0; i < cantidad; i++) {
            cout << opciones[i] << " | ";
        }
        cout << endl;
    }

    void mostrarVertical() {
        for (int i = 0; i < cantidad; i++) {
            cout << opciones[i] << endl;
        }
    }

public:
    Menu() {
        cantidad = 0;
    }

    void agregar(string opcion) {
        opciones[cantidad] = opcion;
        cantidad++;
    }

    void mostrar(string tipo) {
        if (tipo == "horizontal") {
            mostrarHorizontal();
        }
        else if (tipo == "vertical") {
            mostrarVertical();
        }
    }
};

int main() {
    Menu menu;

    menu.agregar("Inicio");
    menu.agregar("Productos");
    menu.agregar("Contacto");

    menu.mostrar("horizontal");

    return 0;
}
