#include <iostream>
using namespace std;

class Hipervinculos {
private:
    string enlaces[5];
    int cantidad;

public:
    Hipervinculos() {
        cantidad = 0;
    }

    void agregar(string enlace) {
        enlaces[cantidad] = enlace;
        cantidad++;
    }

    void mostrar() {
        for (int i = 0; i < cantidad; i++) {
            cout << "<a href='" << enlaces[i] << "'>"
                 << enlaces[i] << "</a> ";
        }
    }
};

int main() {
    Hipervinculos menu;

    menu.agregar("Inicio");
    menu.agregar("Productos");
    menu.agregar("Contacto");

    menu.mostrar();

    return 0;
}
